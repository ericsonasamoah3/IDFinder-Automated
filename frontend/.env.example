# Copy to .env for local development and fill in with values from
# `terraform output` after running terraform apply.
# In deployed environments, Amplify Hosting injects these automatically
# (see terraform/amplify.tf) -- you should not need to edit this file
# for the deployed app to work.

VITE_IDFINDER_API_BASE=
VITE_ID_PROCESS=
VITE_ID_SAVE=

VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URLS=http://localhost:5173
