# --- Terraform ---
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/tfplan
terraform/build/
terraform/crash.log
terraform/crash.*.log
terraform/*.tfvars
terraform/*.tfvars.json
!terraform/*.tfvars.example

# --- Frontend (Vite/React) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# --- Env files -- never commit real secrets/config ---
.env
.env.*
!.env.example
!frontend/.env.example

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# --- Lambda build artifacts (Terraform's archive_file regenerates these) ---
lambdas/**/*.zip

# --- Python bytecode ---
__pycache__/
*.pyc
